datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String            @id @default(cuid())
  name              String
  email             String            @unique
  imageUrl          String?
  carts             Cart[]
  orders            Order[]
  shippingAddresses ShippingAddress[]
}

model Product {
  id              String      @id @default(cuid())
  name            String
  description     String
  slug            String      @unique
  productImage    String
  specifications  String
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id])
  priceInCents    Int
  avaliationStars Float
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  cartItems       CartItem[]
  orderItems      OrderItem[]
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Cart {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  items        CartItem[]
  totalInCents Int
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model ShippingAddress {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  recipientName String
  street        String
  number        String
  complement    String?
  city          String
  neighborhood  String
  zipCode       String
  country       String
  phone         String
  email         String
  cpfOrCnpj     String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  orders        Order[]
}

model Order {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id])
  status            OrderStatus     @default(PENDING_PAYMENT)
  shippingAddressId String
  shippingAddress   ShippingAddress @relation(fields: [shippingAddressId], references: [id])
  items             OrderItem[]
  recipientName     String
  street            String
  number            String
  complement        String?
  city              String
  neighborhood      String
  zipCode           String
  country           String
  phone             String
  email             String
  cpfOrCnpj         String
  totalPriceInCents Int
  expiresAt         DateTime        @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id])
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  quantity     Int
  priceInCents Int
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
}

enum OrderStatus {
  PENDING_PAYMENT
  SUCCESS_PAYMENT
  CANCELLED
}
